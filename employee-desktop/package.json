{
  "name": "employee-status-client",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:config": "electron . --config=../employee.config.json",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "node scripts/package-mac-zip.js",
    "dist:mac:native": "electron-builder --mac dmg",
    "dist:all": "electron-builder --win nsis portable --mac dmg"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.2",
    "electron": "^31.7.7",
    "electron-builder": "^26.15.3",
    "yazl": "^3.3.1"
  },
  "build": {
    "appId": "com.local.employee-status-client",
    "productName": "员工状态上报",
    "directories": {
      "output": "../employee-installers"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "assets/**/*",
      "employee.config.example.json",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "employee.config.example.json",
        "to": "employee.config.json"
      }
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "员工状态上报"
    },
    "portable": {
      "artifactName": "员工状态上报-Windows-便携版.exe"
    },
    "mac": {
      "icon": "assets/app-icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "artifactName": "员工状态上报-Mac-${arch}-安装包.${ext}"
    },
    "artifactName": "${productName}-${os}-${arch}-${version}.${ext}"
  }
}
